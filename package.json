{
  "name": "complicache",
  "version": "1.0.1",
  "description": "Schema-driven Next.js Data Cache — definisikan entri cache, dependency graph, dan model effects sekali, pakai konsisten di semua proyek tanpa ribet cari sambungan.",
  "keywords": [
    "next.js",
    "cache",
    "data-cache",
    "revalidate",
    "invalidate",
    "prisma",
    "schema",
    "complicache"
  ],
  "license": "MIT",
  "author": "mdikifahriza",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdikifahriza/complicache.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./media": {
      "import": {
        "types": "./dist/media/index.d.ts",
        "default": "./dist/media/index.js"
      },
      "require": {
        "types": "./dist/media/index.d.cts",
        "default": "./dist/media/index.cjs"
      }
    },
    "./media/client": {
      "import": {
        "types": "./dist/media/client/index.d.ts",
        "default": "./dist/media/client/index.js"
      },
      "require": {
        "types": "./dist/media/client/index.d.cts",
        "default": "./dist/media/client/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "next": ">=14",
    "sharp": ">=0.32"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "sharp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "next": "^15.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
